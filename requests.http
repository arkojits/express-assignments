### Add user
POST http://127.0.0.1:3000/api/v1/users
Content-Type: application/json

{
  "name": "Test User",
  "username": "testuser",
  "email": "test@example.com",
  "role": "user",
  "password": "password"
}

### Get all users
GET http://127.0.0.1:3000/api/v1/users

### Update user
PUT http://127.0.0.1:3000/api/v1/users/1
Content-Type: application/json

{
  "name": "Updated User"
}

### Delete user
DELETE http://127.0.0.1:3000/api/v1/users/1

### Add cat
POST http://127.0.0.1:3000/api/v1/cats
Content-Type: application/json

{
  "cat_name": "Leo",
  "weight": 6,
  "owner": 1,
  "filename": "cat.jpg",
  "birthdate": "2024-01-10"
}

### Update cat
PUT http://127.0.0.1:3000/api/v1/cats/1
Content-Type: application/json

{
  "cat_name": "Updated Misu"
}

### Delete cat
DELETE http://127.0.0.1:3000/api/v1/cats/1

### Upload cat with image
POST http://127.0.0.1:3000/api/v1/cats
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Leo
--MyBoundary
Content-Disposition: form-data; name="weight"

6
--MyBoundary
Content-Disposition: form-data; name="owner"

1
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2024-01-10
--MyBoundary
Content-Disposition: form-data; name="cat"; filename="cat.jpg"
Content-Type: image/jpeg

< ./public/cat.jpg
--MyBoundary--

### Update cat
PUT http://127.0.0.1:3000/api/v1/cats/1
Content-Type: application/json

{
  "cat_name": "Misu Updated",
  "weight": 5.5,
  "owner": 1,
  "filename": "cat.jpg",
  "birthdate": "2022-05-10"
}

### Delete cat
DELETE http://127.0.0.1:3000/api/v1/cats/2

### Add user
POST http://127.0.0.1:3000/api/v1/users
Content-Type: application/json

{
  "name": "New User",
  "username": "newuser",
  "email": "newuser@example.com",
  "password": "password",
  "role": "user"
}

### Update user
PUT http://127.0.0.1:3000/api/v1/users/1
Content-Type: application/json

{
  "name": "John Updated",
  "username": "johndoe",
  "email": "john@example.com",
  "password": "password",
  "role": "user"
}

### Delete user
DELETE http://127.0.0.1:3000/api/v1/users/2

### Create user with hashed password
POST http://127.0.0.1:3000/api/v1/users
Content-Type: application/json

{
  "name": "Hash Test",
  "username": "hashtest",
  "email": "hashtest@example.com",
  "password": "password123",
  "role": "user"
}
### Login
POST http://127.0.0.1:3000/api/v1/auth/login
Content-Type: application/json

{
  "username": "hashtest",
  "password": "password123"
}
### Get current user
GET http://127.0.0.1:3000/api/v1/auth/me
